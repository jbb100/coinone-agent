# direnv configuration for KAIROS-1
# direnv를 사용하여 디렉토리 진입 시 자동으로 venv 활성화
# 설치: brew install direnv
# 활성화: direnv allow .

# kairos_env 가상환경 자동 활성화
if [ -d "kairos_env" ]; then
    source kairos_env/bin/activate
    export VIRTUAL_ENV="$(pwd)/kairos_env"
    export PATH="$VIRTUAL_ENV/bin:$PATH"
elif [ -d "venv" ]; then
    source venv/bin/activate
    export VIRTUAL_ENV="$(pwd)/venv"
    export PATH="$VIRTUAL_ENV/bin:$PATH"
elif [ -d ".venv" ]; then
    source .venv/bin/activate
    export VIRTUAL_ENV="$(pwd)/.venv"
    export PATH="$VIRTUAL_ENV/bin:$PATH"
fi

# 환경 변수 로드 (있는 경우)
if [ -f ".env" ]; then
    set -a
    source .env
    set +a
fi
